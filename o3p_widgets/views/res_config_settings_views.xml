<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.o3p.widgets</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="O3P Widgets"
                     string="O3P Widgets"
                     name="o3p_widgets"
                     groups="base.group_system">
                    <block title="Widget Settings">
                        <setting id="o3p_widgets_minimum_text_lines"
                                 string="Minimum text lines"
                                 help="Minimum number of lines displayed by text fields. The native Odoo value is 2; changes take effect after refreshing the browser.">
                            <field name="minimum_text_lines"
                                   options="{'type': 'number', 'min': 1}"/>
                        </setting>
                        <setting id="o3p_widgets_minimum_lists_lines"
                                 string="Minimum list lines"
                                 help="Minimum number of rows displayed by list views. The Add a line row counts toward the total. The native Odoo value is 4; changes take effect after refreshing the browser.">
                            <field name="minimum_lists_lines"
                                   options="{'type': 'number', 'min': 0}"/>
                        </setting>
                        <setting id="o3p_widgets_remember_notebook_tabs"
                                 string="Remember notebook tabs"
                                 help="Remember and restore the last open tab in each notebook for 48 hours in this browser. Changes take effect after refreshing the browser.">
                            <field name="remember_notebook_tabs"/>
                        </setting>
                        <setting id="o3p_widgets_default_notebook_tabs"
                                 string="Default notebook tabs"
                                 help="Use URL-prefix rules to choose a notebook tab when this browser has no exact saved tab. Tab indexes start at 0. Changes take effect after refreshing the browser.">
                            <field name="notebook_default_tabs"/>
                            <div class="content-group mt16" invisible="not notebook_default_tabs">
                                <field name="notebook_default_tab_memory_ids"
                                       nolabel="1"
                                       domain="[('mtype', '=', 'lastnbtab')]"
                                       context="{'default_mtype': 'lastnbtab'}">
                                    <list editable="bottom">
                                        <field name="mtype" invisible="1"/>
                                        <field name="tvalue" string="URL Prefix" required="1"/>
                                        <field name="nvalue"
                                               string="Tab Index (from 0)"
                                               required="1"
                                               options="{'type': 'number', 'min': 0}"/>
                                    </list>
                                </field>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
